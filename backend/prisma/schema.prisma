generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                Int                 @id @default(autoincrement())
  username          String              @unique @db.VarChar(100)
  email             String              @unique @db.VarChar(255)
  password          String              @db.VarChar(255)
  first_name        String?             @default("") @db.VarChar(100)
  last_name         String?             @default("") @db.VarChar(100)
  is_staff          Boolean?            @default(false)
  is_superuser      Boolean?            @default(false)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  admin_profiles    admin_profiles?
  contact_messages  contact_messages[]
  service_bookings  service_bookings[]
  service_offerings service_offerings[]
  towing_requests   towing_requests[]
  blog_posts        blog_posts[]
  select_shops      select_shops?
}

model admin_profiles {
  id                Int                 @id @default(autoincrement())
  user_id           Int?                @unique
  full_name         String?             @default("") @db.VarChar(100)
  shop_name         String              @db.VarChar(200)
  phone_number      String?             @default("") @db.VarChar(20)
  city              String?             @default("") @db.VarChar(100)
  shop_address      String?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  users             users?              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact_messages  contact_messages[]
  select_shops      select_shops[]
  service_bookings  service_bookings[]
  service_offerings service_offerings[]
  towing_requests   towing_requests[]
}

model select_shops {
  id             Int             @id @default(autoincrement())
  user_id        Int?            @unique
  select_shop_id Int?
  admin_profiles admin_profiles? @relation(fields: [select_shop_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users          users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model service_offerings {
  id                    Int                     @id @default(autoincrement())
  user_id               Int?
  shop_id               Int?
  title                 String                  @db.VarChar(150)
  description           String
  icon_class            String?                 @default("fas fa-wrench") @db.VarChar(100)
  price_starts_at       Decimal                 @db.Decimal(10, 2)
  is_active             Boolean?                @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  service_booking_items service_booking_items[]
  admin_profiles        admin_profiles?         @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model blog_posts {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  title      String    @db.VarChar(255)
  slug       String    @unique @db.VarChar(255)
  content    String
  image_url  String?   @default("")
  author     String?   @default("Admin") @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model contact_messages {
  id             Int             @id @default(autoincrement())
  user_id        Int?
  shop_id        Int?
  name           String          @db.VarChar(100)
  email          String          @db.VarChar(255)
  subject        String          @db.VarChar(200)
  message        String
  is_read        Boolean?        @default(false)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  admin_profiles admin_profiles? @relation(fields: [shop_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users          users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model towing_requests {
  id              Int             @id @default(autoincrement())
  user_id         Int?
  shop_id         Int?
  full_name       String          @db.VarChar(100)
  phone_number    String          @db.VarChar(20)
  vehicle_details String          @db.VarChar(200)
  pickup_address  String
  latitude        Decimal?        @db.Decimal(10, 6)
  longitude       Decimal?        @db.Decimal(10, 6)
  status          String?         @default("pending") @db.VarChar(20)
  otp             String?         @default("") @db.VarChar(10)
  otp_verified    Boolean?        @default(false)
  requested_at    DateTime?       @default(now()) @db.Timestamp(6)
  admin_profiles  admin_profiles? @relation(fields: [shop_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users           users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model service_bookings {
  id                       Int                     @id @default(autoincrement())
  user_id                  Int?
  shop_id                  Int?
  customer_name            String                  @db.VarChar(100)
  customer_phone           String                  @db.VarChar(20)
  customer_email           String                  @db.VarChar(255)
  vehicle_info             String                  @db.VarChar(200)
  preferred_date           DateTime                @db.Date
  preferred_time           DateTime                @db.Time
  additional_notes         String?                 @default("")
  status                   String?                 @default("pending") @db.VarChar(20)
  otp                      String?                 @default("") @db.VarChar(10)
  otp_verified             Boolean?                @default(false)
  payment_method           String?                 @default("cash") @db.VarChar(20)
  is_paid                  Boolean?                @default(false)
  stripe_payment_intent_id String?                 @db.VarChar(200)
  created_at               DateTime?               @default(now()) @db.Timestamp(6)
  service_booking_items    service_booking_items[]
  admin_profiles           admin_profiles?         @relation(fields: [shop_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users                    users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model service_booking_items {
  booking_id        Int
  service_id        Int
  service_bookings  service_bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_offerings service_offerings @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([booking_id, service_id])
}
